#!/bin/bash

if [ -z "$1" ]; then
	echo "Usage: davinciconvert <input_video>"
	exit 1
fi

for input in "$@"; do
	if [ ! -f "$input" ]; then
		echo "File not found: $input"
		continue
	fi

	# extract filename without extension
	filename=$(basename -- "$input")
	name="${filename%.*}"
	output="${name}.mov"

	echo "Converting '$input' to '$output'..."
	ffmpeg -i "$input" -c:v dnxhd -profile:v dnxhr_hq -pix_fmt yuv422p -c:a alac "$output"
done

echo "Done"
