#!/bin/bash

set -e # exit script on error

show_help() {
    echo "Usage: uploadjellyfin [album_folder1] [album_folder2] ..."
    echo
    echo "Organise and upload music albums to Jellyfin."
    echo "This script:"
    echo "  - Reads metadata (Artist, Album, Year) from music files in a folder"
    echo "  - Creates an Artist folder and moves the album inside it"
    echo "  - Renames the album folder to 'Year - Album'"
    echo "  - Mounts NAS at /mnt/NAS (if not already)"
    echo "  - Uploads to NAS"
    echo "  - Deletes local copy afterwards"
    echo
    echo "Example Structure:"
    echo "Four Tet
    └── 2020 - Sixteen Oceans
        ├── 01 School.flac
        ├── 02 Baby.flac
        ├── 03 Harpsichord.flac
        ├── 04 Teenage Birdsong.flac
        ├── 05 Romantics.flac
        ├── 06 Love Salad.flac
        ├── 07 Insect Near Piha Beach.flac
        ├── 08 Hi Hello.flac
        ├── 09 ISTM.flac
        ├── 10 Something in the Sadness.flac
        ├── 11 1993 Band Practice.flac
        ├── 12 Green.flac
        ├── 13 Bubbles at Overlook 25th March 2019.flac
        ├── 14 4T Recordings.flac
        ├── 15 This Is for You.flac
        ├── 16 Mama Teaches Sanskrit.flac
        └── cover.jpg"
    echo
    echo "Options:"
    echo "  -h, --help     Show this help message and exit"
    echo
}

# If no arguments or -h flag detected, show help and exit
if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi


# Mount NAS to system
if mountpoint -q /mnt/NAS; then
    echo
    echo "NAS already mounted. Skipping mounting process..."
    echo
else
    echo
    echo "Mounting NAS to /mnt/NAS"
    sudo mount -t nfs 10.1.1.171:/nfs/Public /mnt/NAS
    echo "Successfully mounted"
    echo
fi


destination="/mnt/NAS/Music/test"

for album_folder in "$@"; do
    echo "--------------------------------------"
    echo "Processing $album_folder"
    echo "--------------------------------------"

    if [[ ! -d "$album_folder" ]]; then
        echo "ERROR: '$album_folder' is not a directory. Skipping..."
        continue
    fi
    
    # Extract artist from file metadata
    metadata=$(exiftool "$album_folder")
    artist=$(echo "$metadata" | grep -m1 "^Artist[[:space:]]*:" | awk -F': ' '{print $2}')

    # Artist metatdata missing. Requires manual input
    if [[ -z "$artist" ]]; then
        read -p "Artist metdata missing from file. What is the artist of this album? " artist
    fi

    # If multiple artists present, then seperate for user to specify
    delimiter=""
    # Taiki Nulight, borne
    if [[ "$artist" == *","* ]]; then
        delimiter=","
    # Taiki Nulight; borne
    elif [[ "$artist" == *";"* ]]; then
        delimiter=";"
    fi
    
    if [[ -n "$delimiter" ]]; then
        IFS="$delimiter" read -ra artists <<< "$artist" # Split into array
        echo "Multiple artists found:"

        # Display numbered list
        for i in "${!artists[@]}"; do
            echo "$((i+1)). ${artists[$i]# }" # Remove any leading space
        done

        # Prompt user to specify artist to use for folder name
        while true; do
            read -p "Select which artist to use for folder: " choice

            # Validate input
            if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#artists[@]} )); then
                artist="${artists[$((choice-1))]# }"  # Store selected artist
                break
            else
                echo "Invalid selection. Please try again..."
                echo
            fi
        done
    else
        echo "Single artist detected."
    fi

    echo "Selected artist: $artist"
    echo

    # Create directory and move album into folder
    mkdir -p "$artist"
    echo "Created folder '$artist'"
    echo

    mv "$album_folder" "$artist"
    echo "Moved '$album_folder' into '$artist'"
    echo

    # Go inside new artist folder
    cd "$artist"

    album=$(echo "$metadata" | grep -m1 "^Album[[:space:]]*:" | awk -F': ' '{print $2}')

    # Album metatdata missing. Requires manual input
    if [[ -z "$album" ]]; then
        read -p "Album metdata missing from file. What is the album called? " album
    fi

    # Album year can be in mutliple tags such as:
    # - Releasedate
    # - Year
    # - Releasetime
    # 
    # Try each tag until year is extracted
    year=$(echo "$metadata" | grep -im1 "date[[:space:]]*:" | awk -F': ' '{print $2}' | awk -F'-' '{print $1}')

    if [[ -z "$year" ]]; then
        year=$(echo "$metadata" | grep -im1 "year[[:space:]]*:" | awk -F': ' '{print $2}' | awk -F'-' '{print $1}')
    fi

    if [[ -z "$year" ]]; then
        year=$(echo "$metadata" | grep -im1 "time[[:space:]]*:" | awk -F': ' '{print $2}' | awk -F'-' '{print $1}')
    fi

    # Year metatdata missing. Requires manual input
    if [[ -z "$year" ]]; then
        read -p "Year metdata missing from file. What year was this album released? " year
    fi

    # Rename Album folder
    new_album_name="${year} - ${album}"
    if [[ "$album_folder" == $new_album_name ]]; then
        echo "Folder is already in correct format. Skipping..."
        echo
    else
        mv "$album_folder" "$new_album_name"
        echo "Renamed folder to '$new_album_name'"
        echo
    fi

    cd .. # exit album artist folder

    # Upload artist folder to NAS
    echo "Copying '$artist' to '$destination'..."
    echo
    rsync -r -av --progress "$artist" "$destination"

    # Delete original files from system
    echo
    rm -r "$artist"
    echo "Deleted '$artist' from system"
    echo

done
echo "Done."
