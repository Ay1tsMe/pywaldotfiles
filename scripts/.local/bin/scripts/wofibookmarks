#!/bin/bash

BOOKMARKS_FILE="$HOME/.local/bin/scripts/wofi_files/bookmarks"

# Read and pass URLs to wofi
selected_bookmark=$(cat "$BOOKMARKS_FILE" | wofi -d --conf="$HOME/.config/wofi/dmenuconfig" --prompt="Select Bookmark...")

# Type bookmark selected
if [ -n "$selected_bookmark" ]; then
	echo "$selected_bookmark"
	wtype "$selected_bookmark"

fi
